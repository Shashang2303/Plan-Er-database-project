# Copy to .env and adjust. .env is git-ignored (NFR-6): never commit credentials.

# MongoDB in Docker (directConnection=true because the replica-set member is named "mongod" inside
# Docker). Host port 27018, because a native MongoDB Windows service may already use 27017.
MONGO_URI=mongodb://localhost:27018/?directConnection=true
MONGO_DB=planer

# Search backend for the $search / $vectorSearch access paths (NFR-5):
#   mongot = MongoDB Community Search in Docker (default)
#   atlas  = MongoDB Atlas free tier; set ATLAS_URI and load the same data there
#   local  = no mongot: classic $text index for full-text, exact k-NN in Python for vectors
SEARCH_BACKEND=mongot
ATLAS_URI=

# Ollama (local LLM tier). Docker Desktop on this machine has ~3.5 GB RAM, so the default is a
# small model. llama3.1:8b / qwen2.5:7b need ~6 GB: raise Docker's memory limit first.
OLLAMA_URL=http://localhost:11434
LLM_MODELS=qwen2.5:1.5b
LLM_TIMEOUT_S=120

# Embeddings (384-d)
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Cost model (Eq. 1): every operator is charged in USD.
# Local compute (classical matchers, local LLM) is converted at this rate per CPU-second.
USD_PER_COMPUTE_SECOND=0.0001
# Price of one human label in the optimizer's sample (C_label).
USD_PER_LABEL=0.02

MONGOT_PASSWORD=planer-mongot-pw
